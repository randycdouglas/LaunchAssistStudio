<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>LaunchAssistStudio.Web</RootNamespace>
    <UserSecretsId>launchassiststudio-web</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- SMTP fallback transport. Resend needs no package at all. -->
    <PackageReference Include="MailKit" Version="4.17.0" />
  </ItemGroup>

</Project>
