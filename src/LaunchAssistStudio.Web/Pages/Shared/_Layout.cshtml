@{
    var navActive = ViewData["NavActive"] as string ?? "";
    string NavClass(string item) => navActive == item ? "active" : null!;

    const string siteName = "Launch Assist Studio";
    const string origin = "https://launchassiststudio.com";
    var path = Context.Request.Path.Value == "/" ? "" : Context.Request.Path.Value;
    var canonical = origin + path;
    var title = $"{ViewData["Title"]} - {siteName}";
    var description = ViewData["Description"] as string ?? "";
}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#0D1B2A" />
  <title>@title</title>
  <meta name="description" content="@description" />
  <link rel="canonical" href="@canonical" />

  <link rel="icon" type="image/svg+xml" href="~/favicon.svg" />
  <link rel="icon" type="image/png" sizes="32x32" href="~/favicon-32x32.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="~/apple-touch-icon.png" />
  <link rel="manifest" href="~/site.webmanifest" />

  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="@siteName" />
  <meta property="og:title" content="@title" />
  <meta property="og:description" content="@description" />
  <meta property="og:url" content="@canonical" />
  <meta property="og:image" content="@(origin)/og-image.png" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="Launch Assist Studio — websites and custom software that drive real results." />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="@title" />
  <meta name="twitter:description" content="@description" />
  <meta name="twitter:image" content="@(origin)/og-image.png" />

  <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>

<a class="skip-link" href="#main">Skip to main content</a>

<header class="topbar">
  <div class="wrap nav">
    <a asp-page="/Index" class="brand" aria-label="Launch Assist Studio home"><img src="~/assets/launch-assist-logo.svg" alt="Launch Assist Studio" width="210" height="51" /></a>
    <button class="nav-toggle" type="button" aria-label="Toggle navigation" aria-expanded="false" aria-controls="primary-nav">&#9776;</button>
    <nav class="links" id="primary-nav" aria-label="Primary navigation">
      <a asp-page="/Index" class="@NavClass("Home")">Home</a>
      <a asp-page="/Services" class="@NavClass("Services")">Services</a>
      <a asp-page="/Portfolio" class="@NavClass("Portfolio")">Portfolio</a>
      <a asp-page="/About" class="@NavClass("About")">About</a>
      <a asp-page="/Contact" class="@NavClass("Contact")">Contact</a>
      <a class="talk" asp-page="/StartProject">Let's Talk</a>
    </nav>
  </div>
</header>

<main id="main">
@RenderBody()
</main>

<footer>
  <div class="wrap footer-row">
    <img src="~/assets/launch-assist-logo.svg" alt="Launch Assist Studio" width="250" height="60" />
    <p>Websites. Software. E-Commerce. Branding. <strong>Built to Launch Your Success.</strong></p>
    <a href="https://launchassiststudio.com">launchassiststudio.com</a>
  </div>
  <nav class="wrap footer-links" aria-label="Footer navigation">
    <a asp-page="/Services">Services</a>
    <a asp-page="/Pricing">Pricing</a>
    <a asp-page="/Portfolio">Portfolio</a>
    <a asp-page="/About">About</a>
    <a asp-page="/Contact">Contact</a>
    <a asp-page="/StartProject">Start a Project</a>
    <a href="mailto:hello@launchassiststudio.com">hello@launchassiststudio.com</a>
  </nav>
</footer>
<script src="~/js/site.js" asp-append-version="true"></script>
</body>
</html>
