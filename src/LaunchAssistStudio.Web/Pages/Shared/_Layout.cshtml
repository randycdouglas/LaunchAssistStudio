@{
    var navActive = ViewData["NavActive"] as string ?? "";
    string NavClass(string item) => navActive == item ? "active" : null!;
}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#0D1B2A" />
  <title>@ViewData["Title"] - Launch Assist Studio</title>
  <meta name="description" content="@ViewData["Description"]" />
  <link rel="canonical" href="https://launchassiststudio.com@(Context.Request.Path.Value == "/" ? "" : Context.Request.Path.Value)" />
  <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>

<header class="topbar">
  <div class="wrap nav">
    <a asp-page="/Index" class="brand"><img src="~/assets/launch-assist-logo.svg" alt="Launch Assist Studio" /></a>
    <button class="nav-toggle" type="button" aria-label="Toggle navigation">&#9776;</button>
    <nav class="links" aria-label="Primary navigation">
      <a asp-page="/Index" class="@NavClass("Home")">Home</a>
      <a asp-page="/Services" class="@NavClass("Services")">Services</a>
      <a asp-page="/Pricing" class="@NavClass("Pricing")">Pricing</a>
      <a asp-page="/Portfolio" class="@NavClass("Portfolio")">Portfolio</a>
      <a asp-page="/About" class="@NavClass("About")">About</a>
      <a asp-page="/Contact" class="@NavClass("Contact")">Contact</a>
      <a class="talk" asp-page="/StartProject">Let's Talk</a>
    </nav>
  </div>
</header>

<main>
@RenderBody()
</main>

<footer>
  <div class="wrap footer-row">
    <img src="~/assets/launch-assist-logo.svg" alt="Launch Assist Studio" />
    <p>Websites. Software. E-Commerce. Branding. <strong>Built to Launch Your Success.</strong></p>
    <a href="https://launchassiststudio.com">launchassiststudio.com</a>
  </div>
  <div class="wrap footer-links">
    <a asp-page="/Services">Services</a>
    <a asp-page="/Pricing">Pricing</a>
    <a asp-page="/Portfolio">Portfolio</a>
    <a asp-page="/About">About</a>
    <a asp-page="/Contact">Contact</a>
    <a asp-page="/StartProject">Start a Project</a>
    <a href="mailto:hello@launchassiststudio.com">hello@launchassiststudio.com</a>
  </div>
</footer>
<script src="~/js/site.js" asp-append-version="true"></script>
</body>
</html>
