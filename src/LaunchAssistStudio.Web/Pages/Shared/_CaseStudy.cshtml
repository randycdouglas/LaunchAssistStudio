@model CaseStudyViewModel

<div class="work-grid">
  <div>
    <span class="kicker">@Model.Label</span>
    <h2>@Model.Title</h2>
    <p class="lead">@Model.Subtitle — @Model.Description</p>
    <div class="chips">
      @foreach (var tag in Model.Tags)
      {
        <span>@tag</span>
      }
    </div>
    <a asp-page="/StartProject" class="button primary">Discuss Your Project</a>
  </div>
  <div class="dashboard" aria-hidden="true">
    <div class="dash-nav"><b>@Model.LogoInitials</b><i></i><i></i><i></i><i></i></div>
    <div class="dash-body"><div class="dash-title"></div><div class="metric-row"><span></span><span></span><span></span></div><div class="graph"><i></i><i></i><i></i><i></i><i></i><i></i></div></div>
  </div>
</div>
