@model CaseStudyViewModel

<article class="case-study">
  <div class="case-copy">
    <span class="case-label">@Model.Label</span>
    <h3>@Model.Title</h3>
    <h4>@Model.Subtitle</h4>
    <p>@Model.Description</p>
    <div class="tag-list">
      @foreach (var tag in Model.Tags)
      {
        <span>@tag</span>
      }
    </div>
  </div>
  <div class="case-visual" aria-hidden="true">
    <div class="app-shell">
      <div class="app-sidebar"><span class="app-logo">@Model.LogoInitials</span><i></i><i></i><i></i><i></i></div>
      <div class="app-main"><div class="app-head"></div><div class="app-metrics"><b></b><b></b><b></b></div><div class="app-chart"></div></div>
    </div>
  </div>
</article>
