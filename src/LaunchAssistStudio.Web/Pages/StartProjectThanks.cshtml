@page "/start-project/thank-you"
@{
    ViewData["Title"] = "Thank You";
    ViewData["Description"] = "Your project inquiry has been received by Launch Assist Studio.";
    ViewData["NavActive"] = "";
}

<section class="page-hero"><div class="wrap"><span class="kicker">THANK YOU</span><h1>Your project inquiry is on its way.</h1></div></section>

<section class="section-light"><div class="wrap form-shell">
  <div class="success-card">
    <span class="success-icon">&#10003;</span>
    <h2>We've got your details.</h2>
    <p>Thanks for the details &mdash; we'll review everything and follow up within one business day.</p>
    <p class="muted">A confirmation email is headed to your inbox. If you don't see it, check your spam folder or email <a href="mailto:hello@launchassiststudio.com">hello@launchassiststudio.com</a>.</p>
    <p style="margin-top:26px"><a class="button primary" asp-page="/Index">Back to Home</a></p>
  </div>
</div></section>
