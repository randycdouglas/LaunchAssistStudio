@page "/"
@{
    ViewData["Title"] = "Websites & Custom Software";
    ViewData["Description"] = "Websites, e-commerce and custom Microsoft .NET software for businesses ready to launch and grow.";
    ViewData["NavActive"] = "Home";
}

@* Top of the homepage reproduces the approved brand board: brand lockup on
   the left, laptop and phone mockups showing the site on the right. *@
<section class="board-top">
  <div class="wrap board-hero">
    <div class="board-identity">
      <img class="brand-lockup" src="~/assets/launch-assist-logo.svg" alt="Launch Assist Studio" width="430" height="104" />
      <p class="board-eyebrow"><span>WEBSITES</span><i>&bull;</i><span>SOFTWARE</span><i>&bull;</i><span>LOGOS</span><i>&bull;</i><span>BRANDING</span></p>
      <p class="board-tagline">We build powerful digital solutions that help businesses <b>launch</b>, <b>grow</b>, and <b>succeed</b>.</p>
      <div class="board-actions">
        <a class="button primary" asp-page="/Services">Our Services</a>
        <a class="button outline" asp-page="/Portfolio">View Our Work</a>
      </div>
    </div>

    <div class="device-stage" aria-hidden="true">
      <div class="laptop">
        <div class="laptop-lid">
          <div class="laptop-screen">
            <div class="mini-site">
              <div class="mini-nav">
                <img src="~/assets/launch-assist-logo.svg" alt="" />
                <div class="mini-menu"><span>Home</span><span>Services</span><span>Portfolio</span><span>About</span><span>Contact</span></div>
                <span class="mini-talk">Let's Talk</span>
              </div>
              <div class="mini-body">
                <div>
                  <span class="mini-kicker">BUILD. LAUNCH. GROW.</span>
                  <h3>Websites &amp; Custom Software That Drive Real Results.</h3>
                  <p>Professional design. Clean code. Microsoft technologies. Solutions built for your business.</p>
                  <div class="mini-btns"><span class="b1">Our Services</span><span class="b2">View Our Work</span></div>
                </div>
                <div class="mini-art">
                  <div class="mini-panel mp-a">
                    <span class="bar blue" style="width:78%"></span><span class="bar" style="width:60%"></span>
                    <span class="bar" style="width:86%"></span><span class="bar blue" style="width:52%"></span>
                    <span class="bar" style="width:70%"></span><span class="bar" style="width:44%"></span>
                  </div>
                  <div class="mini-panel mp-b">
                    <span class="bar" style="width:52%"></span>
                    <div class="chart"><i></i><i></i><i></i><i></i></div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="laptop-base"></div>
      </div>

      <div class="phone">
        <div class="phone-screen">
          <div class="mini-phone">
            <div class="ptop">
              <img src="~/assets/launch-assist-logo.svg" alt="" />
              <span class="burger"><i></i><i></i><i></i></span>
            </div>
            <span class="pk">BUILD. LAUNCH. GROW.</span>
            <h4>Websites &amp; Custom Software That Drive Real Results.</h4>
            <p>Professional design. Clean code. Microsoft technologies. Solutions built for your business.</p>
            <span class="pbtn">Let's Talk</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

@* Light board panels: services / technology / brand, as laid out on the board. *@
<section class="capabilities" id="services">
  <div class="wrap capability-grid">
    <div class="cap-col services">
      <h2>Services</h2>
      <article><div class="line-icon browser"></div><div><h3>Website Design &amp; Development</h3><p>Custom, responsive websites that look great and perform flawlessly.</p></div></article>
      <article><div class="line-icon code">&lt;/&gt;</div><div><h3>Custom Software Development</h3><p>Scalable web applications and business software built with Microsoft .NET.</p></div></article>
      <article><div class="line-icon database"></div><div><h3>Database Design &amp; Management</h3><p>SQL Server solutions that are secure, reliable and optimized for performance.</p></div></article>
      <article><div class="line-icon cart">&#9635;</div><div><h3>E-Commerce Development</h3><p>Professional online stores with payments, products and integrations.</p></div></article>
      <article><div class="line-icon pencil">&#9998;</div><div><h3>Logo &amp; Branding</h3><p>Professional logos and branding that create a strong, lasting impression.</p></div></article>
      <p style="margin-top:20px;font-size:13px"><a asp-page="/Services" style="color:#1764D8;font-weight:700;text-decoration:none">See all services &rarr;</a></p>
    </div>

    <div class="cap-col tech">
      <h2>Our Technology</h2>
      <div class="tech-logos">
        <div class="tech-logo"><strong>.NET</strong><small>Microsoft</small></div>
        <div class="tech-logo sql"><strong>SQL Server</strong><small>Microsoft</small></div>
      </div>

      <h2 class="palette-title">Color Palette</h2>
      <div class="palette">
        <div><i style="background:#0D1B2A"></i><span>0D1B2A</span></div>
        <div><i style="background:#2563EB"></i><span>2563EB</span></div>
        <div><i style="background:#475569"></i><span>475569</span></div>
        <div><i style="background:#CBD5E1"></i><span>CBD5E1</span></div>
        <div><i style="background:#F8FAFC;border:1px solid #E2E8F0"></i><span>F8FAFC</span></div>
      </div>

      <h2 class="type-title">Typography</h2>
      <div class="type-specimens">
        <div class="poppins"><p class="aa">Aa</p><strong>Poppins Bold</strong><small>ABCDEFGHIJKLMNOPQRSTUVWXYZ abcdefghijklmnopqrstuvwxyz 0123456789</small></div>
        <div class="inter"><p class="aa">Aa</p><strong>Inter Regular</strong><small>ABCDEFGHIJKLMNOPQRSTUVWXYZ abcdefghijklmnopqrstuvwxyz 0123456789</small></div>
      </div>

      <h2 class="type-title">Technology Stack</h2>
      <div class="stack-list">
        <b>C# / .NET 10</b><b>ASP.NET Core</b><b>Blazor</b><b>Entity Framework</b><b>SQL Server</b><b>REST APIs</b>
      </div>
    </div>

    <div class="cap-col values" id="about">
      <h2>Brand Identity</h2>
      <div class="card-mockups">
        <div class="bcard front"><img src="~/assets/launch-assist-logo.svg" alt="Launch Assist Studio logo on a business card" /></div>
        <div class="bcard back">
          <b>Launch Assist Studio</b>
          <em>Websites &bull; Software &bull; Branding</em>
          hello@launchassiststudio.com<br />
          launchassiststudio.com<br /><br />
          Helping businesses launch, grow, and succeed.
        </div>
      </div>

      <h2 class="type-title">Brand Personality</h2>
      <div class="value-grid">
        <div><span class="value-icon">&#8599;</span><h3>Forward</h3><p>We propel your business forward.</p></div>
        <div><span class="value-icon">&#9671;</span><h3>Reliable</h3><p>Solutions you can count on, built to last.</p></div>
        <div><span class="value-icon">&lt;/&gt;</span><h3>Expert</h3><p>Skilled in Microsoft technologies. Focused on results.</p></div>
        <div><span class="value-icon">&#9678;</span><h3>Partner</h3><p>We're invested in your success at every step.</p></div>
      </div>

      <div class="mini-card">
        <img src="~/assets/launch-assist-logo.svg" alt="" />
        <p><strong>Websites. Software. E-Commerce. Branding.</strong><br />Built to launch your success.</p>
      </div>
    </div>
  </div>
</section>

<section class="work" id="work">
  <div class="wrap work-grid">
    <div>
      <span class="kicker">FEATURED SOFTWARE PROJECT</span>
      <h2>Office Assist AI</h2>
      <p class="lead">A custom SaaS platform demonstrating the kind of serious application work Launch Assist Studio can deliver.</p>
      <div class="chips"><span>Multi-Tenant SaaS</span><span>AI</span><span>Voice &amp; SMS</span><span>Scheduling</span><span>Payments</span><span>SQL Server</span><span>APIs</span></div>
      <a asp-page="/StartProject" class="button primary">Discuss Your Project</a>
    </div>
    <div class="dashboard" aria-hidden="true">
      <div class="dash-nav"><b>LA</b><i></i><i></i><i></i><i></i></div>
      <div class="dash-body"><div class="dash-title"></div><div class="metric-row"><span></span><span></span><span></span></div><div class="graph"><i></i><i></i><i></i><i></i><i></i><i></i></div></div>
    </div>
  </div>
</section>

<section class="cta" id="contact">
  <div class="wrap">
    <span class="kicker">READY TO BUILD?</span>
    <h2>Websites &amp; custom software<br />built around your business.</h2>
    <p>Tell us what you're trying to accomplish. We'll help you figure out the right way to build it.</p>
    <a class="button primary large" asp-page="/StartProject">Let's Talk</a>
  </div>
</section>
