@page "/start-project"
@model StartProjectModel
@{
    ViewData["Title"] = "Start a Project";
    ViewData["Description"] = "Tell Launch Assist Studio about your project.";
    ViewData["NavActive"] = "";
}

<section class="page-hero"><div class="wrap"><span class="kicker">START A PROJECT</span><h1>Tell us what you're building.</h1><p>Give us the basics. We'll use your answers to understand the project before we talk.</p></div></section>

<section class="section-light"><div class="wrap form-shell">
<form class="project-form" method="post">
<div asp-validation-summary="All" class="validation-summary"></div>
<input type="hidden" asp-for="FormRenderedAt" />
<div class="hp-field" aria-hidden="true">
  <label>Company fax (leave this blank)<input type="text" name="CompanyFax" value="" tabindex="-1" autocomplete="off" /></label>
</div>

<fieldset><legend><span>01</span> What can we help you with?</legend><p class="field-help">Select all that apply.</p><div class="check-grid">
@foreach (var service in IntakeOptions.Services)
{
  <label class="check-card"><input type="checkbox" class="service-checkbox" name="Input.Services" value="@service" checked="@(Model.Input.Services.Contains(service))"><span>@service</span></label>
}
</div></fieldset>

<fieldset><legend><span>02</span> Tell us about your business.</legend><div class="form-grid">
<label><span>Business Name</span><input asp-for="Input.BusinessName"></label>
<label><span>Current Website</span><input asp-for="Input.CurrentWebsite" placeholder="https://"><span asp-validation-for="Input.CurrentWebsite" class="field-validation-error"></span></label>
<label><span>Industry</span><input asp-for="Input.Industry"></label>
<label class="full"><span>What does your business do?</span><textarea asp-for="Input.BusinessDescription" rows="4"></textarea></label>
</div></fieldset>

<fieldset><legend><span>03</span> Tell us about the project.</legend>
<label class="full"><span>What are you trying to build or improve? *</span><textarea asp-for="Input.ProjectDescription" rows="6" required></textarea><span asp-validation-for="Input.ProjectDescription" class="field-validation-error"></span></label>
</fieldset>

<fieldset id="ecommerceQuestions" class="conditional-section @(Model.ShowEcommerce ? "visible" : "")"><legend><span>04</span> E-Commerce Details</legend><div class="form-grid">
<label><span>What will you sell?</span><select asp-for="Input.EcommerceSellType"><option value="">Select one</option>@foreach (var o in IntakeOptions.SellTypes) { <option>@o</option> }</select></label>
<label><span>Approximate product count</span><select asp-for="Input.EcommerceProductCount"><option value="">Select one</option>@foreach (var o in IntakeOptions.ProductCounts) { <option>@o</option> }</select></label>
<label><span>Existing store/platform</span><input asp-for="Input.EcommerceExistingPlatform" placeholder="Shopify, WooCommerce, Etsy, none..."></label>
<label><span>Do you need inventory tracking?</span><select asp-for="Input.EcommerceInventoryNeeds"><option value="">Select one</option>@foreach (var o in IntakeOptions.YesNoNotSure) { <option>@o</option> }</select></label>
<label><span>Will you ship products?</span><select asp-for="Input.EcommerceShipping"><option value="">Select one</option>@foreach (var o in IntakeOptions.ShippingOptions) { <option>@o</option> }</select></label>
<label><span>Subscriptions or memberships?</span><select asp-for="Input.EcommerceSubscriptions"><option value="">Select one</option>@foreach (var o in IntakeOptions.YesNoNotSure) { <option>@o</option> }</select></label>
<label><span>Sales tax handling needed?</span><select asp-for="Input.EcommerceTaxes"><option value="">Select one</option>@foreach (var o in IntakeOptions.TaxOptions) { <option>@o</option> }</select></label>
<label><span>Preferred payment provider</span><select asp-for="Input.EcommercePaymentProvider"><option value="">Select one</option>@foreach (var o in IntakeOptions.PaymentProviders) { <option>@o</option> }</select></label>
<label><span>Integrations needed?</span><input asp-for="Input.EcommerceIntegrations" placeholder="Accounting, inventory, shipping, marketplaces..."></label>
<label><span>Migrating products, customers or orders?</span><select asp-for="Input.EcommerceMigration"><option value="">Select one</option>@foreach (var o in IntakeOptions.MigrationOptions) { <option>@o</option> }</select></label>
</div></fieldset>

<fieldset id="softwareQuestions" class="conditional-section @(Model.ShowSoftware ? "visible" : "")"><legend><span>05</span> Software Details</legend><div class="form-grid">
<label><span>Type of software</span><select asp-for="Input.SoftwareApplicationType"><option value="">Select one</option>@foreach (var o in IntakeOptions.SoftwareTypes) { <option>@o</option> }</select></label>
<label><span>New or existing application?</span><select asp-for="Input.SoftwareNewOrExisting"><option value="">Select one</option>@foreach (var o in IntakeOptions.NewOrExisting) { <option>@o</option> }</select></label>
<label><span>Existing technology (if known)</span><input asp-for="Input.SoftwareCurrentTechnology" placeholder=".NET, SQL Server, WordPress, etc."></label>
<label><span>Will users need accounts / logins?</span><select asp-for="Input.SoftwareLoginRequirements"><option value="">Select one</option>@foreach (var o in IntakeOptions.LoginRequirements) { <option>@o</option> }</select></label>
<label><span>Systems to integrate with</span><input asp-for="Input.SoftwareIntegrations" placeholder="QuickBooks, Stripe, Microsoft 365, custom APIs..."></label>
<label><span>Existing data to migrate?</span><select asp-for="Input.SoftwareDataMigration"><option value="">Select one</option>@foreach (var o in IntakeOptions.DataMigrationOptions) { <option>@o</option> }</select></label>
<label><span>What would need to be migrated?</span><input asp-for="Input.SoftwareMigrationNeeds" placeholder="Customers, orders, documents, legacy database..."></label>
<label class="full"><span>What business problem should this solve, and what should the workflow look like?</span><textarea asp-for="Input.SoftwareBusinessProblem" rows="4"></textarea></label>
</div></fieldset>

<fieldset><legend><span>06</span> Budget &amp; timing.</legend><div class="form-grid">
<label><span>Approximate budget</span><select asp-for="Input.Budget"><option value="">Select one</option>@foreach (var o in IntakeOptions.Budgets) { <option>@o</option> }</select></label>
<label><span>When would you like to start?</span><select asp-for="Input.Timeline"><option value="">Select one</option>@foreach (var o in IntakeOptions.Timelines) { <option>@o</option> }</select></label>
<label><span>Target launch date</span><input asp-for="Input.TargetLaunchDate" type="date"><span asp-validation-for="Input.TargetLaunchDate" class="field-validation-error"></span></label>
</div></fieldset>

<fieldset><legend><span>07</span> Contact information.</legend><div class="form-grid">
<label><span>Your Name *</span><input asp-for="Input.ContactName" required autocomplete="name"><span asp-validation-for="Input.ContactName" class="field-validation-error"></span></label>
<label><span>Email *</span><input asp-for="Input.Email" type="email" required autocomplete="email"><span asp-validation-for="Input.Email" class="field-validation-error"></span></label>
<label><span>Phone</span><input asp-for="Input.Phone" type="tel" autocomplete="tel"><span asp-validation-for="Input.Phone" class="field-validation-error"></span></label>
<label><span>Preferred contact</span><select asp-for="Input.PreferredContact">@foreach (var o in IntakeOptions.PreferredContacts) { <option>@o</option> }</select></label>
<label class="full"><span>Anything else we should know?</span><textarea asp-for="Input.AdditionalNotes" rows="4"></textarea></label>
</div></fieldset>

<div class="form-submit">
<label class="agreement"><input asp-for="Input.Agreement" required><span>I understand that submitting this form does not create a contractual agreement or guarantee project availability.</span></label>
<button class="button primary large" type="submit">Start My Project</button>
<p>Or email <a href="mailto:hello@launchassiststudio.com">hello@launchassiststudio.com</a></p>
</div>
</form></div></section>
