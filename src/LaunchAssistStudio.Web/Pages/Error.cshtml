@page "/error"
@model ErrorModel
@{
    ViewData["Title"] = "Something went wrong";
    ViewData["Description"] = "An error occurred.";
    ViewData["NavActive"] = "";
    var notFound = Model.ErrorStatusCode == 404;
}

<section class="page-hero"><div class="wrap"><span class="kicker">@(notFound ? "404" : "ERROR")</span><h1>@(notFound ? "Page not found." : "Something went wrong.")</h1></div></section>

<section class="section-light"><div class="wrap form-shell">
  <div class="success-card">
    <span class="success-icon">!</span>
    @if (notFound)
    {
      <h2>We couldn't find that page.</h2>
      <p class="muted">The page you're looking for doesn't exist or has moved.</p>
    }
    else
    {
      <h2>Sorry about that.</h2>
      <p class="muted">Please try again, or email <a href="mailto:hello@launchassiststudio.com">hello@launchassiststudio.com</a>.</p>
    }
    <p style="margin-top:26px"><a class="button primary" asp-page="/Index">Back to Home</a></p>
  </div>
</div></section>
