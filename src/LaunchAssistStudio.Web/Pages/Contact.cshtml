@page "/contact"
@{
    ViewData["Title"] = "Contact";
    ViewData["Description"] = "Contact Launch Assist Studio.";
    ViewData["NavActive"] = "Contact";
}

<section class="page-hero"><div class="wrap"><span class="kicker">CONTACT</span><h1>Let's talk about what you're building.</h1><p>For project inquiries, use the guided intake form or email us directly.</p></div></section>

<section class="section-light"><div class="wrap form-shell">
