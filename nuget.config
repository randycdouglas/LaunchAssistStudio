<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <!--
      The official Mailtrap .NET SDK is published to Mailtrap's GitHub Packages
      feed, not nuget.org. Credentials are NOT stored in this file; each machine
      registers them once with "dotnet nuget add source" (see README).
    -->
    <add key="github-mailtrap" value="https://nuget.pkg.github.com/mailtrap/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
